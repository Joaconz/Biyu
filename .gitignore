# --- Secretos ---
.env
.env.*
!.env.example

# --- Node / Vite (React PWA) ---
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Supabase CLI ---
supabase/.temp/
supabase/.branches/

# --- Datos que nunca deben entrar al repo (C13, C14) ---
*.csv
*.pdf
*.dump
/dumps/
/exports/
# Las migraciones SQL versionadas sí se commitean (C15):
!supabase/migrations/*.sql
!supabase/seed.sql

# --- Coverage ---
coverage/
htmlcov/
.nyc_output/

# --- Editor / SO ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Logs y misceláneo ---
*.log
.cache/
.playwright-cli/

# --- Claude Code: estado local, no se versiona ---
.claude/settings.local.json
.claude/worktrees/

# --- Skills externas: solo se versionan las instrucciones (.md) ---
# Los datos, scripts y tests de ui-ux-pro-max (~130k líneas) se reinstalan con `npx skills add`.
.claude/skills/ui-ux-pro-max/data/
.claude/skills/ui-ux-pro-max/scripts/
.agents/skills/ui-ux-pro-max/data/
.agents/skills/ui-ux-pro-max/scripts/
.claude/skills/shadcn/assets/
.claude/skills/shadcn/evals/
.claude/skills/shadcn/agents/
.agents/skills/shadcn/assets/
.agents/skills/shadcn/evals/
.agents/skills/shadcn/agents/

# Copiá este archivo a .env y completá los valores. .env nunca se commitea (C8, C13).
# Los dos valores salen de Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon). NUNCA pongas acá la service_role key.
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Vercel: cargá estas dos variables en Project Settings → Environment Variables
# ANTES del deploy. Vite las inlinea en build time; sin ellas la app queda en blanco.
